# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=auto   # auto = le modèle Flash le plus récent
# Code famille demandé par l'app (protège ta clé)
APP_PIN=1234
# Compte parent ONE (optionnel, pour la synchro automatique du cahier de textes)
ONE_URL=https://one.opendigitaleducation.com
ONE_LOGIN=
ONE_PASSWORD=
# Synchro entre appareils (Supabase gratuit) : même code famille = mêmes devoirs partout
SUPABASE_URL=
SUPABASE_KEY=
SYNC_SECRET=
